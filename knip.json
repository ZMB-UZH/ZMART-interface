{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "vite": false,
  "entry": [
    "zmart_interface/api/index.ts",
    "zmart_interface/framework/fixtures/*/flow.ts",
    "examples/*/flow.ts",
    "zmart_interface/**/*.test.{js,ts}",
    "tools/*.mjs",
    "vite.config.js",
    "examples/**/*.test.{js,ts}",
    "examples/**/*.spec.{js,ts}"
  ],
  "project": [
    "zmart_interface/**/*.{js,mjs,ts}",
    "examples/**/*.{js,mjs,ts}",
    "tools/*.mjs",
    "!examples/built-page/**"
  ],
  "ignoreDependencies": [
    "zmart-viewer"
  ],
  "ignore": [
    "examples/*/canvas/engines/zmart-viewer-drawing/**"
  ],
  "ignoreExportsUsedInFile": {
    "interface": true,
    "type": true
  }
}
